# Local runtime secrets for `wrangler dev` / `opennextjs-cloudflare preview`.
# Copy this file to `.dev.vars` (gitignored) and fill in real values.
# Production values are set with `wrangler secret put <NAME>` or in CI.

# Selects which Next.js .env file to load (development | production).
NEXTJS_ENV=development

# better-auth: random 32+ char secret used to sign sessions/tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# better-auth: the app's base URL (used for callbacks / cookies).
BETTER_AUTH_URL=http://localhost:3000

# Resend: transactional email API key (email OTP delivery).
RESEND_API_KEY=re_replace_with_real_key

# Resend: verified sender address. In dev, use onboarding@resend.dev
# (delivers only to your own Resend signup email).
EMAIL_FROM=onboarding@resend.dev
